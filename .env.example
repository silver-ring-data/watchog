# ntfy topics. Treat each like a password: anyone who knows it can read your
# alerts and publish to you. Generate fresh ones, do not reuse these samples:
#   python -c "import secrets; print('watchog-sys-' + secrets.token_urlsafe(9))"
#
# One topic per module, so subscribing on the phone is how you choose scope.
NTFY_TOPIC=watchog-sys-CHANGE-ME          # heartbeat, errors, test alerts
NTFY_TOPIC_MOVIE=watchog-movie-CHANGE-ME
NTFY_TOPIC_JOBS=watchog-jobs-CHANGE-ME
NTFY_TOPIC_FLIGHT=watchog-flight-CHANGE-ME
# Inbox for the 유용/무시 buttons on alerts. watchog polls it; you never subscribe to it.
NTFY_TOPIC_FEEDBACK=watchog-feedback-CHANGE-ME

# Only needed for a self-hosted or reserved topic; the free public server
# requires no auth.
# NTFY_TOKEN=

# changedetection.io (docker compose up -d). The API key is generated on first
# start: UI -> Settings -> API.
CDIO_URL=http://localhost:5000
CDIO_API_KEY=

# Gemini free tier, used by the LLM-scored watchers (jobs, gamenews).
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# healthchecks.io ping URL for the daily heartbeat (python -m watchog ops daily). Optional.
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>
