# ntfy topic. Treat this like a password: anyone who knows it can read your
# alerts and publish to you. Generate a fresh one, do not reuse this sample.
NTFY_TOPIC=watchog-CHANGE-ME

# Only needed for a self-hosted or reserved topic; the free public server
# requires no auth.
# NTFY_TOKEN=

# Gemini free tier, used by the LLM-scored watchers (jobs, gamenews).
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
